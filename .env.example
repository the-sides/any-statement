OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6
OPENROUTER_PDF_ENGINE=cloudflare-ai
OPENROUTER_HTTP_REFERER=http://localhost:3000

NOTION_API_KEY=
NOTION_DATA_SOURCE_ID=
NOTION_CATEGORY_DATA_SOURCE_ID=

# Provisioned by the Neon marketplace integration; holds months and categories.
DATABASE_URL=

# WorkOS AuthKit. The redirect URI must also be registered in the WorkOS
# dashboard under Redirects, along with the sign-in URL (/sign-in).
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_COOKIE_PASSWORD=
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/callback

# Upload/debug artifacts only; safe to leave on the ephemeral /tmp default.
STATEMENT_LEDGER_ARTIFACT_DIR=/tmp/statement-ledger
