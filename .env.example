# OpenRouter is the one credential every user shares.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6
OPENROUTER_PDF_ENGINE=cloudflare-ai
OPENROUTER_HTTP_REFERER=http://localhost:3000

# Notion is *not* configured here. Each user connects their own workspace in the
# app, and the integration token is stored encrypted in `notion_connections`.
# Moving an old deployment's NOTION_* values into one user's row:
#   STATEMENT_LEDGER_LEGACY_USER_ID=user_... bun run scripts/import-notion-connection.ts

# Provisioned by the Neon marketplace integration; holds every user's ledger.
DATABASE_URL=

# WorkOS AuthKit. The redirect URI must also be registered in the WorkOS
# dashboard under Redirects, along with the sign-in URL (/sign-in).
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_COOKIE_PASSWORD=
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/callback

# Comma-separated addresses allowed to use the ledger. A WorkOS session only
# proves someone signed in, so without this anyone who can sign up gets in.
# Unset means nobody is allowed -- it fails closed on purpose.
STATEMENT_LEDGER_ALLOWED_EMAILS=

# Encrypts stored Notion integration tokens (32 base64 bytes).
#   bun run scripts/generate-secret-key.ts
# Rotating it makes every stored token unreadable, so users must reconnect.
STATEMENT_LEDGER_SECRET_KEY=

# One-time migration aid: the WorkOS user id that owns rows written before the
# ledger was per-user. Only `scripts/migrate.ts` and the import scripts read it.
STATEMENT_LEDGER_LEGACY_USER_ID=

# Auth-less demo build: bypasses the WorkOS gate and runs every request as the
# seeded demo tenant (`lib/demoMode.ts`). For headless UI checks, which cannot
# complete AuthKit's redirect flow. Ignored when VERCEL_ENV=production.
#   STATEMENT_LEDGER_DEMO_MODE=1 bun run scripts/seed-demo.ts
STATEMENT_LEDGER_DEMO_MODE=

# Upload/debug artifacts only; safe to leave on the ephemeral /tmp default.
STATEMENT_LEDGER_ARTIFACT_DIR=/tmp/statement-ledger
